{
  "name": "revolution-desktop",
  "productName": "Revolution",
  "version": "0.1.4-preview.4",
  "private": true,
  "description": "Revolution workflow workspace powered by DeepSeek Harness",
  "author": "Revolution",
  "license": "MIT",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "node launch.mjs",
    "web": "node runtime.mjs",
    "package": "node ../../scripts/prepare-windows-packaging.mjs && electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.2",
    "dsh-workflow-studio": "file:../../plugins/workflow-studio",
    "revolution-brand": "file:../../plugins/revolution-brand",
    "node": "24.22.0",
    "revolution-knowledge": "file:../../plugins/revolution-knowledge"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.0",
    "fast-uri": "3.1.9",
    "fflate": "0.8.3",
    "undici": "8.12.2",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "app.revolution.workspace",
    "productName": "Revolution",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "./after-pack.cjs",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "main.cjs",
      "auth.html",
      "auth-preload.cjs",
      "relay-config.json",
      "runtime.mjs",
      "icon.png",
      "package.json",
      "profile.mjs"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "timestamp": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/app/node_modules/node/bin/node",
        "Contents/Resources/app/node_modules/@larksuite/cli/bin/lark-cli"
      ],
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
