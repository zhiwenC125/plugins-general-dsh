#!/bin/zsh
set -euo pipefail

# 项目根目录 = 本脚本所在目录
ROOT="$(cd "$(dirname "$0")" && pwd)"
DSH_HOME_DIR="$ROOT/.dsh-smoke"
DSH_SOURCE="$ROOT/deepseek-harness"
PNPM_BIN="$DSH_SOURCE/node_modules/.bin/pnpm"

if [ ! -f "$DSH_SOURCE/package.json" ]; then
  echo "找不到 DeepSeek Harness 源码：$DSH_SOURCE" >&2
  exit 1
fi

if [ ! -f "$DSH_HOME_DIR/profiles/web/package.json" ]; then
  echo "找不到 web profile：$DSH_HOME_DIR/profiles/web" >&2
  exit 1
fi

if [ ! -x "$PNPM_BIN" ]; then
  echo "DeepSeek Harness 依赖尚未安装，请先在项目根目录运行：npm run setup" >&2
  exit 1
fi

export DSH_HOME="$DSH_HOME_DIR"
exec "$PNPM_BIN" --dir "$DSH_SOURCE" dsh --profile web "$@"
