{
  "name": "dsh-ui-change",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npx --yes pnpm@11.25.0 --dir deepseek-harness install --frozen-lockfile",
    "build": "node plugins/workflow-studio/scripts/build.mjs",
    "build:harness": "./deepseek-harness/node_modules/.bin/pnpm --dir deepseek-harness run build",
    "start": "./dsh-studio",
    "version:dsh": "./dsh-studio --version",
    "test:workflow": "node --test plugins/workflow-studio/tests/*.test.js",
    "kb": "node knowledge/cli.mjs",
    "test:knowledge": "node --test knowledge/*.test.mjs",
    "test:bot": "node --test integrations/bot/*.test.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "setup:revolution": "npm run build && npm run build:brand && npm run build:knowledge && npm --prefix apps/revolution install --install-links && node scripts/prepare-desktop.mjs",
    "start:revolution": "npm --prefix apps/revolution start",
    "web:revolution": "npm --prefix apps/revolution run web",
    "package:revolution": "node scripts/prepare-desktop.mjs && npm --prefix apps/revolution run package",
    "build:knowledge": "node plugins/revolution-knowledge/scripts/build.mjs",
    "test:knowledge-app": "node --test plugins/revolution-knowledge/tests/*.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
